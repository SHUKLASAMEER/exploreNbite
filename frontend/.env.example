# Copy this file to .env.local and adjust as needed for local development.

# Base URL of the separate Express API (see backend/.env — PORT). No trailing
# slash; frontend code appends paths like "/api/admin/categories" to this.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Canonical public origin of the site. Used for metadataBase, the sitemap,
# robots.txt, per-page canonical URLs and absolute OpenGraph/Twitter image
# URLs. No trailing slash. REQUIRED in a production build (e.g.
# https://www.explorenbite.com); locally it may be left as localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
