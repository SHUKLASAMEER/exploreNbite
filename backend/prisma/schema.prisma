// Explore N Bite — Prisma schema (MySQL)
// Source of truth: Phase 1.5 Decision & Architecture Lock Report, Section 4.
// Approved decisions encoded here:
//  - Categories are flat (no parent_id)
//  - A post has exactly one *primary* category (required FK, not many-to-many)
//  - Tags are many-to-many via post_tags
//  - post_categories (added: WP-fidelity sync, see /category/[slug] brief) is
//    an *additive* many-to-many extension, not a replacement of the above —
//    it holds only the extra categories a post also belongs to on the live
//    WordPress site (e.g. a post primarily filed under "must-visit" that
//    WordPress also tags "home"). categoryId/category stays the single
//    required primary category everywhere else in the app (admin list
//    column, single-select edit form, etc.); only the public category-archive
//    listing query also matches against post_categories, so a page like
//    /category/home/ can show every post WordPress files there without
//    changing what "the" category of a post means anywhere else.
//  - Comments are flat (no parent_comment_id / no self-relation)
//  - Menu items support ONE level of nesting via a nullable parentId
//    self-relation (added: Admin Menu ↔ public nav sync). A `group` link
//    type is a dropdown parent that has no destination of its own — its
//    children (rows whose parentId points at it) are the dropdown entries.
//    All pre-existing rows keep parentId = null (top level); nothing about
//    page / category / custom_url targeting changed.
//  - No related_posts table — related posts are computed at query time
//  - No views_count column — view counter is deferred
//  - Media is a standalone reusable library; content tables store plain image
//    URLs (no polymorphic media-attachment table)
//  - Settings is a singleton row (id always 1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / people
// ---------------------------------------------------------------------------

model Admin {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(190)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedMedia Media[]

  @@map("admins")
}

model Author {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  bio          String?  @db.Text
  photoUrl     String?  @map("photo_url") @db.VarChar(500)
  facebookUrl  String?  @map("facebook_url") @db.VarChar(300)
  twitterUrl   String?  @map("twitter_url") @db.VarChar(300)
  instagramUrl String?  @map("instagram_url") @db.VarChar(300)
  createdAt    DateTime @default(now()) @map("created_at")

  posts Post[]

  @@map("authors")
}

// ---------------------------------------------------------------------------
// Taxonomy
// ---------------------------------------------------------------------------

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  posts           Post[]
  menuItems       MenuItem[]
  additionalPosts PostCategory[]

  @@map("categories")
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(80)
  slug String @unique @db.VarChar(100)

  posts PostTag[]

  @@map("tags")
}

// ---------------------------------------------------------------------------
// Posts
// ---------------------------------------------------------------------------

enum PostStatus {
  draft
  published
}

model Post {
  id               Int        @id @default(autoincrement())
  title            String     @db.VarChar(200)
  slug             String     @unique @db.VarChar(220)
  categoryId       Int        @map("category_id")
  authorId         Int        @map("author_id")
  featuredImageUrl String?    @map("featured_image_url") @db.VarChar(500)
  shortDescription String?    @map("short_description") @db.VarChar(300)
  content          String     @db.LongText
  status           PostStatus @default(draft)
  allowComments    Boolean    @default(true) @map("allow_comments")
  // WordPress "Sticky Post" flag — mirrors the live site's front-page
  // behavior exactly (see post.service.js#list): only the "/" all-posts
  // feed pins sticky posts above the rest (newest-sticky-first, then the
  // remaining posts newest-first); category archives ignore this and stay
  // plain date-desc, matching what the live site actually does.
  sticky           Boolean    @default(false)
  publishDate      DateTime   @default(now()) @map("publish_date")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author     Author         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  tags       PostTag[]
  comments   Comment[]
  categories PostCategory[]
  revisions  PostRevision[]

  @@index([categoryId])
  @@index([authorId])
  @@index([status, publishDate])
  @@map("posts")
}

// ---------------------------------------------------------------------------
// Post revisions (Autosave + Revisions task)
// ---------------------------------------------------------------------------
// Immutable snapshots of a post's EDITABLE content only — never the live
// Post row itself. Two sources write here:
//   - "autosave": a debounced background snapshot from the open editor.
//   - "manual": taken automatically right after a successful explicit
//     create/Save, so revision history also captures every real save.
// Restoring a revision (post.service.js#restoreRevision) only READS a row
// and hands it back to the client editor — it never writes to Post. The
// existing create/update path (with its existing tag/category
// reconciliation) is still the only thing that ever persists a change to a
// live post, exactly as before this task.
//
// categoryId/authorId/categoryIds are plain historical values with NO
// foreign key — a revision is a point-in-time record, not a live relation,
// so an old snapshot can never block deleting a category/author and needs
// no cascade beyond its own post. tagNames stores tag NAME strings (the
// same shape the editor already works with); restoring only ever feeds
// them back through the existing resolveTagIds() reconciliation, so no
// duplicate Tag/PostTag rows are possible. featuredImageUrl is a URL
// reference only — never a copy of the underlying file.
enum RevisionType {
  autosave
  manual
}

model PostRevision {
  id               Int          @id @default(autoincrement())
  postId           Int          @map("post_id")
  type             RevisionType @default(autosave)
  title            String       @db.VarChar(200)
  slug             String       @db.VarChar(220)
  shortDescription String?      @map("short_description") @db.VarChar(300)
  content          String       @db.LongText
  featuredImageUrl String?      @map("featured_image_url") @db.VarChar(500)
  categoryId       Int?         @map("category_id")
  categoryIds      Json?        @map("category_ids")
  authorId         Int?         @map("author_id")
  tagNames         Json         @map("tag_names")
  createdAt        DateTime     @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("post_revisions")
}

// Additive extra-category links — see the schema-header note above. A row
// here means "this post also shows up under this category," on top of its
// required primary categoryId.
model PostCategory {
  postId     Int @map("post_id")
  categoryId Int @map("category_id")

  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
  @@map("post_categories")
}

model PostTag {
  postId Int @map("post_id")
  tagId  Int @map("tag_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// ---------------------------------------------------------------------------
// Static pages
// ---------------------------------------------------------------------------

// A page's behavior is driven by this explicit type, NOT by matching its
// slug or title (which an admin can freely rename). "contact" and
// "work_with_me" pages get the matching enquiry form appended below their
// content; "standard" is a plain content page.
enum PageType {
  standard
  contact
  work_with_me
}

model Page {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(200)
  slug         String   @unique @db.VarChar(220)
  content      String   @db.LongText
  pageType     PageType @default(standard) @map("page_type")
  showInMenu   Boolean  @default(false) @map("show_in_menu")
  menuPosition Int?     @map("menu_position")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  menuItems MenuItem[]

  @@map("pages")
}

// ---------------------------------------------------------------------------
// Books
// ---------------------------------------------------------------------------

model Book {
  id            Int      @id @default(autoincrement())
  title         String   @db.VarChar(200)
  coverImageUrl String?  @map("cover_image_url") @db.VarChar(500)
  description   String   @db.Text
  publishedYear Int?     @map("published_year") @db.Year
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  buyLinks BookBuyLink[]

  @@map("books")
}

model BookBuyLink {
  id           Int    @id @default(autoincrement())
  bookId       Int    @map("book_id")
  platformName String @map("platform_name") @db.VarChar(80)
  url          String @db.VarChar(500)
  sortOrder    Int    @default(0) @map("sort_order")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("book_buy_links")
}

// ---------------------------------------------------------------------------
// Awards / mentions
// ---------------------------------------------------------------------------

// Which fixed sidebar badge slot (if any) this award fills. Replaces the old
// fragile "identify the badge by matching its title / sourceLink string"
// approach — the public sidebar now selects badges by this explicit value.
// award_photo / tripoto / indiblogger are single-occupant slots (enforced in
// award.service.js, since MySQL has no partial unique index); `none` is the
// default and any number of awards can be `none`.
enum AwardBadgeSlot {
  none
  award_photo
  tripoto
  indiblogger
}

model Award {
  id           Int            @id @default(autoincrement())
  title        String         @db.VarChar(200)
  imageUrl     String?        @map("image_url") @db.VarChar(500)
  sourceLink   String?        @map("source_link") @db.VarChar(500)
  dateReceived DateTime?      @map("date_received") @db.Date
  badgeSlot    AwardBadgeSlot @default(none) @map("badge_slot")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@map("awards")
}

// ---------------------------------------------------------------------------
// Comments (flat — no threading)
// ---------------------------------------------------------------------------

enum CommentStatus {
  pending
  approved
  spam
}

model Comment {
  id         Int           @id @default(autoincrement())
  postId     Int           @map("post_id")
  readerName String        @map("reader_name") @db.VarChar(120)
  email      String        @db.VarChar(190)
  message    String        @db.Text
  status     CommentStatus @default(pending)
  createdAt  DateTime      @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, status])
  @@map("comments")
}

// ---------------------------------------------------------------------------
// Menu (flat — no nesting; page / category / custom_url target)
// ---------------------------------------------------------------------------

enum MenuLinkType {
  page
  category
  custom_url
  // A dropdown parent with no link target of its own ("Travel", "More About
  // Me"). Its dropdown entries are the MenuItems whose parentId points here.
  group
}

model MenuItem {
  id         Int          @id @default(autoincrement())
  label      String       @db.VarChar(80)
  linkType   MenuLinkType @map("link_type")
  pageId     Int?         @map("page_id")
  categoryId Int?         @map("category_id")
  customUrl  String?      @map("custom_url") @db.VarChar(500)
  sortOrder  Int          @default(0) @map("sort_order")
  // One level of nesting only: a top-level item has parentId = null; a
  // dropdown child points at its `group` parent. Cascade delete so removing
  // a group takes its children with it (they have nowhere else to live).
  parentId   Int?         @map("parent_id")

  page     Page?      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  category Category?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemChildren")

  @@index([pageId])
  @@index([categoryId])
  @@index([parentId])
  @@map("menu_items")
}

// ---------------------------------------------------------------------------
// Newsletter
// ---------------------------------------------------------------------------

enum SubscriberStatus {
  active
  unsubscribed
}

model Subscriber {
  id           Int              @id @default(autoincrement())
  email        String           @unique @db.VarChar(190)
  status       SubscriberStatus @default(active)
  subscribedAt DateTime         @default(now()) @map("subscribed_at")

  @@map("subscribers")
}

// ---------------------------------------------------------------------------
// Media library
// ---------------------------------------------------------------------------

model Media {
  id         Int      @id @default(autoincrement())
  fileUrl    String   @map("file_url") @db.VarChar(500)
  fileName   String   @map("file_name") @db.VarChar(255)
  altText    String?  @map("alt_text") @db.VarChar(255)
  uploadedBy Int?     @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  uploader Admin? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([uploadedBy])
  @@map("media")
}

// ---------------------------------------------------------------------------
// Settings (singleton)
// ---------------------------------------------------------------------------

model Settings {
  id                Int     @id @default(1)
  siteTitle         String  @map("site_title") @db.VarChar(150)
  tagline           String? @map("tagline") @db.VarChar(200)
  logoUrl           String? @map("logo_url") @db.VarChar(500)
  heroImageUrl      String? @map("hero_image_url") @db.VarChar(500)
  socialFacebook    String? @map("social_facebook") @db.VarChar(300)
  socialTwitter     String? @map("social_twitter") @db.VarChar(300)
  socialInstagram   String? @map("social_instagram") @db.VarChar(300)
  contactEmail      String  @map("contact_email") @db.VarChar(190)
  footerText        String? @map("footer_text") @db.VarChar(300)
  // Site-wide SEO defaults — the fallback <meta name="description"> and
  // og:image for any public route that doesn't set its own (posts still
  // override via shortDescription / featuredImageUrl). Not "AI SEO"; just the
  // one editorial default pair.
  metaDescription   String? @map("meta_description") @db.VarChar(300)
  defaultOgImageUrl String? @map("default_og_image_url") @db.VarChar(500)

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Sidebar widget configuration
// ---------------------------------------------------------------------------
// Editorial control over which sidebar widgets appear, and in what order, for
// each supported sidebar layout (home / archive / post / page / contact /
// utility). Code still owns the widget *registry* — what each widget key
// renders, its sticky behavior, its data needs, its copy — see
// backend/src/config/sidebarWidgets.js. This table only stores per-(layout,
// widget) visibility + order. One row per (layout, widgetKey); a widget with
// no row for a layout simply isn't shown there.

model SidebarWidgetSetting {
  id        Int     @id @default(autoincrement())
  layout    String  @db.VarChar(30)
  widgetKey String  @map("widget_key") @db.VarChar(40)
  enabled   Boolean @default(true)
  sortOrder Int     @map("sort_order")

  @@unique([layout, widgetKey])
  @@index([layout])
  @@map("sidebar_widget_settings")
}

// ---------------------------------------------------------------------------
// Contact / "Work With Me" enquiries
// ---------------------------------------------------------------------------
// Public enquiry submissions from the Contact and Work With Me pages. Always
// persisted; an email to Settings.contactEmail is *attempted* only when a
// mail transport is configured (see utils/mailer.js) — the flow never
// depends on email working. `handled` is a simple admin "dealt with" flag.

enum EnquiryTopic {
  contact
  work_with_me
}

model ContactMessage {
  id        Int          @id @default(autoincrement())
  topic     EnquiryTopic @default(contact)
  name      String       @db.VarChar(120)
  email     String       @db.VarChar(190)
  subject   String?      @db.VarChar(200)
  message   String       @db.Text
  handled   Boolean      @default(false)
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([handled, createdAt])
  @@map("contact_messages")
}
