# Copy this file to .env and fill in real local values.
# Never commit the real .env file — it is already covered by the root .gitignore.

# MySQL connection string used by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/explorenbite"

NODE_ENV="development"
PORT=4000

# The Next.js frontend's origin — used for CORS. Must match exactly
# (scheme + host + port). May be a comma-separated list to allow more than
# one origin (e.g. apex + www). REQUIRED in production (the server refuses
# to start with this unset, or pointing at localhost, when NODE_ENV=production).
FRONTEND_URL="http://localhost:3000"

# JWT auth. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be >= 32 characters in production (enforced at startup).
JWT_SECRET="replace-with-a-long-random-development-secret"
JWT_EXPIRES_IN="7d"

# --- Admin dev bypass (LOCAL DEVELOPMENT ONLY) ---------------------------
# When NODE_ENV=development, requests to /api/admin/* from a localhost Host
# with no session are treated as the first admin, so /admin can be browsed
# without logging in. It is IGNORED when NODE_ENV=production, and a
# production start with it set to a truthy value fails fast. Set it to false
# to require a real login in local dev too.
# ADMIN_DEV_BYPASS="false"

# --- Session cookie (env-driven so one codebase works for both topologies) ---
# Same registrable domain for frontend + API  -> leave these at the defaults.
# Different registrable domains (cross-site)  -> COOKIE_SAMESITE=none and
#                                                COOKIE_SECURE=true (needs HTTPS).
# COOKIE_SAMESITE  lax (default) | none | strict
# COOKIE_SECURE    true | false   (default: true when NODE_ENV=production;
#                                 COOKIE_SECURE=false is rejected in production)
# COOKIE_DOMAIN    optional explicit cookie Domain (e.g. .explorenbite.com)
# COOKIE_SAMESITE="lax"
# COOKIE_SECURE="true"
# COOKIE_DOMAIN=""

# --- Uploaded media ------------------------------------------------------
# Files are written to backend/uploads/ on local disk. In production that is
# only safe if the directory is a persistent mounted volume, OR media is
# served from object storage / a CDN.
#
#  ASSET_BASE_URL      Absolute origin that stored media URLs are built from.
#                      Leave unset to store root-relative "/uploads/..." URLs
#                      (the frontend proxies /uploads to this API). Set it to
#                      a CDN / dedicated media origin to store absolute URLs.
#  MEDIA_STORAGE_ACK   In production, if ASSET_BASE_URL is unset you MUST set
#                      this to "persistent-volume" to confirm backend/uploads
#                      is a persistent mounted volume (not ephemeral container
#                      storage). Otherwise the server refuses to start.
ASSET_BASE_URL=""
# MEDIA_STORAGE_ACK="persistent-volume"

# --- Contact-form email (optional; enquiries are stored either way) -----
# When SMTP_HOST and SMTP_FROM are BOTH set, the contact / work-with-me
# endpoint attempts to email Settings.contactEmail via a generic SMTP
# transport (nodemailer). If unset, enquiries are still stored and the API
# honestly reports emailed:false. A delivery failure never fails the request.
#  SMTP_SECURE  true  => implicit TLS (use with port 465)
#               false => STARTTLS  (use with port 587 — the default)
#               unset => derived from the port (true only for 465)
#  SMTP_USER / SMTP_PASS may be omitted for IP-allow-listed relays.
SMTP_HOST=""
SMTP_PORT=587
# SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Rate limiting (in-memory; single instance only) -------------------
# Optional overrides for the two limits; defaults shown. See
# middleware/rateLimit.js — a shared store (Redis) is required before
# running more than one backend instance.
# RATE_LIMIT_LOGIN_MAX=10          # sign-in attempts / 15 min / IP
# RATE_LIMIT_PUBLIC_WRITE_MAX=20   # contact + subscribe + comment / 10 min / IP

# Cloudinary (unused — placeholder for a possible future storage integration).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Development seed admin (prisma/seed.js). Never use a real/production
# password here, and change SEED_ADMIN_EMAIL away from the default before
# seeding any non-local database.
SEED_ADMIN_NAME="Explore N Bite Admin"
SEED_ADMIN_EMAIL="admin@explorenbite.local"
SEED_ADMIN_PASSWORD="change-me-in-local-env"
