# Copy this file to .env and fill in real local values.
# Never commit the real .env file — it is already covered by the root .gitignore.

# MySQL connection string used by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/explorenbite"

NODE_ENV="development"
PORT=4000

# The Next.js frontend's origin — used for CORS (Access-Control-Allow-Origin)
# and must match exactly (scheme + host + port).
FRONTEND_URL="http://localhost:3000"

# JWT auth. Generate a long random string for local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-development-secret"
JWT_EXPIRES_IN="7d"

# Cloudinary (image storage — Phase 1.5 Section 5 decision).
# Upload implementation is out of scope until a later phase; these are
# placeholders so the module can be wired up without an env change.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Development seed admin (prisma/seed.js). Never use a real/production
# password here — this is a local development account only.
SEED_ADMIN_NAME="Explore N Bite Admin"
SEED_ADMIN_EMAIL="admin@explorenbite.local"
SEED_ADMIN_PASSWORD="change-me-in-local-env"
